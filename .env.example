# Backend API (server-only — do NOT prefix with NEXT_PUBLIC)
API_ENDPOINT=https://your-api-dev.example.com/api

# Public environment variables (exposed to browser)
NEXT_PUBLIC_URL=http://localhost:3000

# LINE LIFF (optional — remove if not using LINE login)
# NEXT_PUBLIC_LIFF_ID=your-liff-id

# Socket (optional — remove if not using WebSocket)
# NEXT_PUBLIC_SOCKET_ENDPOINT=https://your-socket-dev.example.com

# Mock API (development only — MSW intercepts backend requests)
# NEXT_PUBLIC_MOCK_API=true
